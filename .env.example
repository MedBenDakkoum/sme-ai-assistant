# ==========================================
# App - variables d'environnement backend
# ==========================================

# PostgreSQL (service "postgres" dans docker-compose)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ragmcp
SPRING_DATASOURCE_USERNAME=raguser
SPRING_DATASOURCE_PASSWORD=ragpassword

# ==========================================
# Secrets externes — RENSEIGNER CES VALEURS
# ==========================================
# Clé API OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=

# Credentials Mailtrap (https://mailtrap.io -> SMTP Settings)
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# Email destinataire des escalades
ESCALATION_RECIPIENT_EMAIL=